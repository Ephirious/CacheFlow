initDefaultData {
    INSERT OR IGNORE INTO Accounts (id, name, funds, color, created_at, updated_at)
    VALUES
    (
        :cashAccountId,
        'Наличные',
        '5000.00',
        '#66BB6A',
        (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
        (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
    ),
    (
        :cardAccountId,
        'Банковская карта',
        '5000.00',
        '#F59E0B',
        (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
        (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
    )
    ;

    INSERT OR IGNORE INTO Operations (
            id,
            account_uuid,
            category_uuid,
            transfer_id,
            amount,
            date,
            notes,
            created_at,
            updated_at
        )
        VALUES
        (
            :cashOpId,
            :cashAccountId, -- Наличные
            NULL,
            NULL,
            '5000.00',
            (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
            'Начальный баланс (Наличные)',
            (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
            (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
        ),
        (
            :cardOpId,
            :cardAccountId, -- Банковская карта
            NULL,
            NULL,
            '5000.00',
            (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
            'Начальный баланс (Карта)',
            (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
            (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
        );

    INSERT OR IGNORE INTO Categories (id, name, emoji, type, created_at, updated_at)
    VALUES
    (:catWorkId, 'Работа', '💻', 'income', (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')), (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))),
    (:catFoodId, 'Продукты', '🛍', 'outcome', (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')), (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))),
    (:catTransportId,  'Транспорт', '🚘', 'outcome', (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')), (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))),
    (:catHomeId,  'Жилье', '🏠', 'outcome', (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')), (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))),
    (:catEntertainmentId, 'Развлечения', '🎮', 'outcome', (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')), (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))),
    (:catHealthId,  'Здоровье', '🚑', 'outcome', (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')), (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')));
}

clearAllTables {
    DELETE FROM Operations;
    DELETE FROM Transfers;
    DELETE FROM Accounts;
    DELETE FROM Categories;

    DELETE FROM SyncOperations;
}