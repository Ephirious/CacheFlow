import dbEnums.CategoryType;
import kotlin.Boolean;
import kotlin.time.Instant;

CREATE TABLE IF NOT EXISTS Categories (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    emoji TEXT NOT NULL,
    type TEXT AS CategoryType NOT NULL,
    is_deleted INTEGER AS Boolean NOT NULL DEFAULT 0,
    created_at TEXT AS Instant NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT AS Instant NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
);

selectAll:
SELECT * FROM Categories ORDER BY name ASC;

selectById:
SELECT * FROM Categories WHERE id = ? ORDER BY name ASC;

upsert:
INSERT INTO Categories(id, name, emoji, type)
VALUES (?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    name = excluded.name,
    updated_at = (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));


insert:
INSERT INTO Categories(id, name, emoji, type)
VALUES (?, ?, ?, ?);

update:
UPDATE Categories
SET
    name = ?,
    emoji = ?,
    updated_at = (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
WHERE id = ?;

delete:
DELETE FROM Categories WHERE id = ?;

softDelete:
UPDATE Categories SET is_deleted = 1 WHERE id = ?;

selectActive:
SELECT * FROM Categories
WHERE is_deleted = 0
ORDER BY name ASC;