import utils.types.BigDecimal;
import kotlin.time.Instant;

CREATE TABLE IF NOT EXISTS Accounts (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    funds TEXT AS BigDecimal NOT NULL,
    created_at TEXT AS Instant NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT AS Instant NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
);

selectAll:
SELECT * FROM Accounts ORDER BY name ASC;

selectById:
SELECT * FROM Accounts WHERE id = ? ORDER BY name ASC;

upsert:
INSERT INTO Accounts(id, name, funds)
VALUES (?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    name = excluded.name,
    funds = excluded.funds,
    updated_at = (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));

updateAccountBalance:
UPDATE Accounts
SET funds = funds + :delta,
    updated_at = (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))
WHERE id = :id;

delete:
DELETE FROM Accounts WHERE id = ?;