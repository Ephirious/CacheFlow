import kotlin.time.Instant;

CREATE TABLE IF NOT EXISTS Transfers (
    id TEXT NOT NULL PRIMARY KEY,
    account_from_id TEXT NOT NULL,
    account_to_id TEXT NOT NULL,
    created_at TEXT AS Instant NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    updated_at TEXT AS Instant NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
    FOREIGN KEY (account_from_id) REFERENCES Accounts(id),
    FOREIGN KEY (account_to_id) REFERENCES Accounts(id)
);


CREATE TRIGGER IF NOT EXISTS trg_transfers_sync_insert
AFTER INSERT ON Transfers
BEGIN
    INSERT INTO SyncOperations (id, processing_id, action, table_type, created_at)
    VALUES (lower(hex(randomblob(16))), new.id, 'create', 'transfer', strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));
END;


CREATE TRIGGER IF NOT EXISTS trg_transfers_sync_update_from
AFTER UPDATE OF account_from_id ON Transfers
WHEN old.account_from_id IS NOT new.account_from_id
     AND NOT EXISTS (SELECT 1 FROM SyncOperations WHERE processing_id = new.id AND action = 'create')
BEGIN
    INSERT INTO SyncOperations (id, processing_id, action, table_type, field_to_update, value_to_update, created_at)
    VALUES (lower(hex(randomblob(16))), new.id, 'update', 'transfer', 'account_from_id', new.account_from_id, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));
END;

CREATE TRIGGER IF NOT EXISTS trg_transfers_sync_update_to
AFTER UPDATE OF account_to_id ON Transfers
WHEN old.account_to_id IS NOT new.account_to_id
     AND NOT EXISTS (SELECT 1 FROM SyncOperations WHERE processing_id = new.id AND action = 'create')
BEGIN
    INSERT INTO SyncOperations (id, processing_id, action, table_type, field_to_update, value_to_update, created_at)
    VALUES (lower(hex(randomblob(16))), new.id, 'update', 'transfer', 'account_to_id', new.account_to_id, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));
END;

CREATE TRIGGER IF NOT EXISTS trg_transfers_sync_delete
BEFORE DELETE ON Transfers
BEGIN
    INSERT INTO SyncOperations (id, processing_id, action, table_type, created_at)
    SELECT lower(hex(randomblob(16))), old.id, 'delete', 'transfer', strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
    WHERE NOT EXISTS (SELECT 1 FROM SyncOperations WHERE processing_id = old.id AND action = 'create');

    DELETE FROM SyncOperations WHERE processing_id = old.id AND action != 'delete';
END;

selectAll:
SELECT * FROM Transfers;

selectById:
SELECT * FROM Transfers WHERE id = ?;

upsert:
INSERT INTO Transfers(id, account_from_id, account_to_id)
VALUES (?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    id = excluded.id,
    account_from_id = excluded.account_from_id,
    account_to_id = excluded.account_to_id,
    updated_at = (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));

delete:
DELETE FROM Transfers WHERE id = ?;