    CREATE TRIGGER IF NOT EXISTS trg_operations_sync_delete
    BEFORE DELETE ON Operations
    WHEN (SELECT is_sync_running FROM SyncSettings LIMIT 1) = 0
    BEGIN
        INSERT INTO SyncOperations (id, processing_id, action, table_type, created_at)
