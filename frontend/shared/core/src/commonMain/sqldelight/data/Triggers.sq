    END;
    
    
    CREATE TRIGGER IF NOT EXISTS trg_transfers_sync_update_from
    AFTER UPDATE OF account_from_id ON Transfers
    WHEN (SELECT is_sync_running FROM SyncSettings LIMIT 1) = 0
         AND old.account_from_id IS NOT new.account_from_id
         AND NOT EXISTS (SELECT 1 FROM SyncOperations WHERE processing_id = new.id AND action = 'create')
    BEGIN
        INSERT INTO SyncOperations (id, processing_id, action, table_type, field_to_update, value_to_update, created_at)
        VALUES (lower(hex(randomblob(16))), new.id, 'update', 'transfer', 'account_from_id', new.account_from_id, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));
