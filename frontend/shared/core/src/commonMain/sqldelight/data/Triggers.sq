createTriggers {
    CREATE TRIGGER IF NOT EXISTS trg_accounts_sync_insert
    AFTER INSERT ON Accounts
    WHEN (SELECT is_sync_running FROM SyncSettings LIMIT 1) = 0
    BEGIN
        INSERT INTO SyncOperations (id, processing_id, action, table_type, created_at)
        VALUES (lower(hex(randomblob(16))), new.id, 'create', 'accounts', strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));
    END;
    
    CREATE TRIGGER IF NOT EXISTS trg_accounts_sync_update_name
    AFTER UPDATE OF name ON Accounts
    WHEN (SELECT is_sync_running FROM SyncSettings LIMIT 1) = 0
    AND old.name IS NOT new.name AND NOT EXISTS (
        SELECT 1 FROM SyncOperations WHERE processing_id = new.id AND action = 'create'
    )
    BEGIN
        INSERT INTO SyncOperations (id, processing_id, action, table_type, field_to_update, value_to_update, created_at)
        VALUES (lower(hex(randomblob(16))), new.id, 'update', 'accounts', 'name', new.name, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));
    END;
    
    CREATE TRIGGER IF NOT EXISTS trg_accounts_sync_update_color
    AFTER UPDATE OF color ON Accounts WHEN (SELECT is_sync_running FROM SyncSettings LIMIT 1) = 0
    AND old.color IS NOT new.color AND NOT EXISTS (
        SELECT 1 FROM SyncOperations WHERE processing_id = new.id AND action = 'create'
    )
    BEGIN
        INSERT INTO SyncOperations (id, processing_id, action, table_type, field_to_update, value_to_update, created_at)
        VALUES (lower(hex(randomblob(16))), new.id, 'update', 'accounts', 'color', new.color, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));
    END;
    
    CREATE TRIGGER IF NOT EXISTS trg_accounts_sync_delete
    BEFORE DELETE ON Accounts
    WHEN (SELECT is_sync_running FROM SyncSettings LIMIT 1) = 0
    BEGIN
        INSERT INTO SyncOperations (id, processing_id, action, table_type, created_at)
            SELECT lower(hex(randomblob(16))), old.id, 'delete', 'accounts', strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
            WHERE NOT EXISTS (
                SELECT 1 FROM SyncOperations
                WHERE processing_id = old.id AND action = 'create'
            );
    
            DELETE FROM SyncOperations
            WHERE processing_id = old.id AND action != 'delete';
    END;
    
    CREATE TRIGGER IF NOT EXISTS trg_accounts_sync_soft_delete
    AFTER UPDATE OF is_deleted ON Accounts
    WHEN (SELECT is_sync_running FROM SyncSettings LIMIT 1) = 0
    AND old.is_deleted = 0 AND new.is_deleted = 1
    BEGIN
    
        DELETE FROM SyncOperations WHERE processing_id = new.id AND action = 'create';
    
        INSERT INTO SyncOperations (id, processing_id, action, table_type, created_at)
        SELECT lower(hex(randomblob(16))), new.id, 'delete', 'accounts', strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
        WHERE NOT EXISTS (SELECT 1 FROM SyncOperations WHERE processing_id = new.id AND action = 'create');
    
        DELETE FROM SyncOperations WHERE processing_id = new.id AND action != 'delete';
    END;
    
    --end trgs
    
    
    CREATE TRIGGER IF NOT EXISTS trg_categories_sync_insert
    AFTER INSERT ON Categories
    WHEN (SELECT is_sync_running FROM SyncSettings LIMIT 1) = 0
    BEGIN
        INSERT INTO SyncOperations (id, processing_id, action, table_type, created_at)
        VALUES (lower(hex(randomblob(16))), new.id, 'create', 'categories', strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));
    END;
    
    CREATE TRIGGER IF NOT EXISTS trg_categories_sync_soft_delete
    AFTER UPDATE OF is_deleted ON Categories
    WHEN (SELECT is_sync_running FROM SyncSettings LIMIT 1) = 0
    AND old.is_deleted = 0 AND new.is_deleted = 1
    BEGIN
        DELETE FROM SyncOperations WHERE processing_id = new.id AND action = 'create';
    
        INSERT INTO SyncOperations (id, processing_id, action, table_type, created_at)
        SELECT lower(hex(randomblob(16))), new.id, 'delete', 'categories', strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
        WHERE NOT EXISTS (SELECT 1 FROM SyncOperations WHERE processing_id = new.id AND action = 'create');
    
        DELETE FROM SyncOperations WHERE processing_id = new.id AND action != 'delete';
    END;
    
    
    CREATE TRIGGER IF NOT EXISTS trg_categories_sync_update_name
    AFTER UPDATE OF name ON Categories
    WHEN (SELECT is_sync_running FROM SyncSettings LIMIT 1) = 0
    AND new.is_deleted = 0
         AND old.name IS NOT new.name
         AND NOT EXISTS (SELECT 1 FROM SyncOperations WHERE processing_id = new.id AND action = 'create')
    BEGIN
        INSERT INTO SyncOperations (id, processing_id, action, table_type, field_to_update, value_to_update, created_at)
        VALUES (lower(hex(randomblob(16))), new.id, 'update', 'categories', 'name', new.name, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));
    END;
    
    CREATE TRIGGER IF NOT EXISTS trg_categories_sync_update_emoji
    AFTER UPDATE OF emoji ON Categories
    WHEN (SELECT is_sync_running FROM SyncSettings LIMIT 1) = 0
    AND new.is_deleted = 0
         AND old.emoji IS NOT new.emoji
         AND NOT EXISTS (SELECT 1 FROM SyncOperations WHERE processing_id = new.id AND action = 'create')
    BEGIN
        INSERT INTO SyncOperations (id, processing_id, action, table_type, field_to_update, value_to_update, created_at)
        VALUES (lower(hex(randomblob(16))), new.id, 'update', 'categories', 'emoji', new.emoji, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));
    END;
    
    
