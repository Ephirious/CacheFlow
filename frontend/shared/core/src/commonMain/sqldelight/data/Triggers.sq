        DELETE FROM SyncOperations WHERE processing_id = old.id AND action != 'delete';
    END;
    
    
    CREATE TRIGGER IF NOT EXISTS trg_transfers_sync_insert
    AFTER INSERT ON Transfers
    WHEN (SELECT is_sync_running FROM SyncSettings LIMIT 1) = 0
