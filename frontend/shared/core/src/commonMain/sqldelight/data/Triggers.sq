    CREATE TRIGGER IF NOT EXISTS trg_operations_sync_update_transfer
    AFTER UPDATE OF transfer_id ON Operations
    WHEN (SELECT is_sync_running FROM SyncSettings LIMIT 1) = 0
    AND old.transfer_id IS NOT new.transfer_id AND NOT EXISTS  (SELECT 1 FROM SyncOperations WHERE processing_id = new.id AND action = 'create')
    BEGIN
        INSERT INTO SyncOperations (id, processing_id, action, table_type, field_to_update, value_to_update, created_at)
        VALUES (lower(hex(randomblob(16))), new.id, 'update', 'operations', 'transfer_id', new.transfer_id, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));
