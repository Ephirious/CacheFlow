    CREATE TRIGGER IF NOT EXISTS trg_operations_sync_update_account
    AFTER UPDATE OF account_uuid ON Operations
    WHEN (SELECT is_sync_running FROM SyncSettings LIMIT 1) = 0
    AND old.account_uuid IS NOT new.account_uuid AND NOT EXISTS (SELECT 1 FROM SyncOperations WHERE processing_id = new.id AND action = 'create')
