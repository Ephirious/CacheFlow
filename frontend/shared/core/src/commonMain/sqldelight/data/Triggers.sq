    CREATE TRIGGER IF NOT EXISTS trg_operations_sync_update_date
    AFTER UPDATE OF date ON Operations
    WHEN (SELECT is_sync_running FROM SyncSettings LIMIT 1) = 0
    AND old.date IS NOT new.date AND NOT EXISTS (SELECT 1 FROM SyncOperations WHERE processing_id = new.id AND action = 'create')
    BEGIN
        INSERT INTO SyncOperations (id, processing_id, action, table_type, field_to_update, value_to_update, created_at)
        VALUES (lower(hex(randomblob(16))), new.id, 'update', 'operations', 'date', CAST(new.date AS TEXT), strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));
    END;
    
    CREATE TRIGGER IF NOT EXISTS trg_operations_sync_update_notes
    AFTER UPDATE OF notes ON Operations
    WHEN (SELECT is_sync_running FROM SyncSettings LIMIT 1) = 0
    AND old.notes IS NOT new.notes AND NOT EXISTS (SELECT 1 FROM SyncOperations WHERE processing_id = new.id AND action = 'create')
    BEGIN
        INSERT INTO SyncOperations (id, processing_id, action, table_type, field_to_update, value_to_update, created_at)
        VALUES (lower(hex(randomblob(16))), new.id, 'update', 'operations', 'notes', new.notes, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));
